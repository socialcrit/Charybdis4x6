#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <130>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <40>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <130>;
    require-prior-idle-ms = <40>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Скобки — одновременное нажатие соседних клавиш

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <21 22>;  // O + P
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;  // I + O
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <19 20>;  // U + I
            bindings = <&kp MINUS>;    // -
        };

        // Переключение языка — J + K одновременно
        // Переключение языка с Shift — D + F одновременно (Right Command + Shift + Space)

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;  // Grave + Backspace одновременно
            bindings = <&studio_unlock>;
        };
    };

    behaviors {
        ToLayerTap: ToLayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "TOLAYERTAP";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4          &kp N5         &kp N6     &kp N7               &kp N8       &kp N9     &kp N0         &kp EQUAL
&kp TAB         &kp Q   &kp W   &kp E         &kp R           &kp T          &kp Y      &kp U                &kp I        &kp O      &kp P          &kp BACKSPACE
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &lt 5 F         &kp G          &kp H      &lt 5 J              &kp K        &kp L      &kt SEMICOLON  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V           &lt 3 B        &kp N      &kp M                &lt 1 COMMA  &lt 2 DOT  &lt 4 SLASH    &kp ENTER
                                &kp LEFT_WIN  &lt 1 UP_ARROW  &lt 7 ENTER    &lt 0 DEL  &ToLayerTap 6 SPACE
                                              &lt 2 LEFT      &lt 4 DOWN     &kp ENTER
            >;
        };

        snipe-layers {
            bindings = <
&kp F1  &kp F2         &kp F3          &kp F4            &kp F5                &kp F6     &kp F7             &kp F8                 &kp F9             &kp F10          &kp F11           &kp F12
&trans  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp TAB    &kp LG(BACKSPACE)  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp RIGHT_BRACKET
&trans  &trans         &trans          &trans            &trans                &trans     &mkp RCLK          &mkp LCLK              &trans             &trans           &trans            &kp BACKSLASH
&trans  &trans         &trans          &trans            &trans                &trans     &trans             &trans                 &trans             &trans           &trans            &trans
                                       &trans            &trans                &trans     &mkp RCLK          &mkp LCLK
                                                         &trans                &trans     &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans             &trans    &trans         &trans          &trans     &kp MINUS  &kp EQUAL
&trans  &trans  &trans  &trans  &trans          &trans             &kp HOME  &kp PAGE_UP    &msc SCRL_UP    &trans     &trans     &kp RBKT
&trans  &trans  &trans  &trans  &trans          &trans             &kp LEFT  &kp DOWN       &kp UP          &kp RIGHT  &trans     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans          &trans             &kp END   &kp PAGE_DOWN  &msc SCRL_DOWN  &trans     &trans     &trans
                        &trans  &kp UP_ARROW    &kp RIGHT_ARROW    &trans    &trans
                                &kp LEFT_ARROW  &kp DOWN_ARROW     &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        // Layer 6: CARET — трекбол двигает текстовый курсор (стрелки) вместо мыши
        // Все клавиши прозрачны, клавиатура работает как обычно

        caret_layer {
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LS(HOME)  &kp C_AC_SEARCH  &kp K_MUTE  &kp C_VOLUME_DOWN    &kp C_VOLUME_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
                                                          &trans           &trans      &trans               &trans           &trans
                                                                           &trans      &trans               &trans
            >;
        };

        Browser {
            bindings = <
&trans  &trans     &kp LC(ENTER)    &kp LC(L)         &trans         &trans      &trans  &trans  &trans           &trans         &trans     &trans
&trans  &kp LC(W)  &kp LC(LS(T))    &kp LC(T)         &trans         &trans      &trans  &trans  &kp LC(T)        &kp LC(LS(T))  &kp LC(W)  &trans
&trans  &trans     &kp LS(LC(TAB))  &kp LC(TAB)       &trans         &trans      &trans  &trans  &kp LS(LC(TAB))  &kp LC(TAB)    &trans     &trans
&trans  &trans     &msc MOVE_Y(20)  &msc MOVE_Y(-20)  &trans         &trans      &trans  &trans  &trans           &trans         &trans     &trans
                                    &trans            &kp PG_UP      &kp HOME    &trans  &trans
                                                      &kp PAGE_DOWN  &kp END     &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_NUMLOCK  &kp SLASH  &kp ASTERISK  &kp MINUS  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp N7          &kp N8     &kp N9        &kp PLUS   &kp DEL  &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans  &trans    &kp N4          &kp N5     &kp N6        &kp PLUS   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp N1          &kp N2     &kp N3        &kp ENTER  &trans   &kp ENTER
                        &trans  &trans  &trans    &kp N0          &kp DOT
                                &trans  &trans    &to 0
            >;
        };

        KeyMouseLayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
